# Зависимости
node_modules/

# Сборка: AppImage, .deb, .exe, .dmg и распакованные каталоги весят
# сотни мегабайт и не должны попадать в git. В GitHub Actions они
# собираются нативно на раннере каждой ОС.
dist/

# Логи и временное
*.log
npm-debug.log*
.npm/

# Кэш генератора иконок
scripts/__pycache__/

# Конфиг сервера с ключом отправки. Лежит в /srv/puuush-server/config.json
# с правами 600 и в репозиторий не должен. На случай копии конфига в
# корне — эти файлы игнорируются.
config.json
*.local.json
.env
.env.*

# Системный мусор
.DS_Store
Thumbs.db
desktop.ini

# Редакторы
.idea/
.vscode/
*.swp

# The house standard's own files. The rule above
# was meant for the repository's config, not for these.
!.impeccable/config.json
