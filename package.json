{
  "name": "puuush",
  "version": "1.1.0",
  "engines": {
    "node": ">=22"
  },
  "description": "Скриншот области -> загрузка -> ссылка в буфере обмена",
  "homepage": "https://github.com/aa-blinov/puuush",
  "main": "src/main.js",
  "author": {
    "name": "aa-blinov"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "prestart": "npm run build:renderer",
    "cli": "electron . --cli",
    "build:renderer": "vite build",
    "icons": "electron scripts/render-icons.cjs",
    "shots": "electron scripts/shots.cjs",
    "dist": "electron-builder --mac --win --linux --publish never",
    "predist": "npm run build:renderer",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "test": "node --test test/puuush.test.js test/regressions.test.js",
    "check": "npm run build:renderer && svelte-check --tsconfig ./jsconfig.json && node --test test/puuush.test.js test/regressions.test.js && node --check src/main.js && node --check src/upload.js && node --check server/index.js",
    "check:ui": "svelte-check --tsconfig ./jsconfig.json",
    "test:electron": "electron test/electron/region-check.js && electron test/electron/thin-selection-check.js && electron test/electron/settings-window-check.js",
    "pretest:electron": "npm run build:renderer",
    "check:site": "electron scripts/check-site.cjs",
    "dist:mac:arm64": "electron-builder --mac --arm64 --publish never",
    "dist:mac:x64": "electron-builder --mac --x64 --publish never",
    "release:notes": "node scripts/release-notes.cjs"
  },
  "build": {
    "appId": "com.blinov.puuush",
    "productName": "puuush",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "extendInfo": {
        "LSUIElement": true
      },
      "artifactName": "puuush-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "puuush-${version}-setup.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "assets/icon.png",
      "maintainer": "aa-blinov",
      "synopsis": "Скриншот области и ссылка в буфере",
      "syncDesktopName": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "aa-blinov",
        "repo": "puuush"
      }
    ],
    "deb": {
      "artifactName": "puuush_${version}_${arch}.${ext}"
    }
  },
  "devDependencies": {
    "@monos/ui": "github:aa-blinov/monos-ui",
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "autoprefixer": "^10.6.1",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.31",
    "svelte": "^4.2.20",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^3.4.19",
    "vite": "^5.4.21"
  },
  "desktopName": "puuush"
}
