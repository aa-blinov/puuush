{
  "name": "puuush",
  "version": "1.0.0",
  "description": "Скриншот области -> загрузка -> ссылка в буфере обмена",
  "homepage": "https://github.com/aa-blinov/puuush",
  "main": "src/main.js",
  "author": {
    "name": "aa-blinov"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "cli": "electron . --cli",
    "icons": "python3 scripts/make-icons.py",
    "dist": "electron-builder --mac --win --linux",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "test": "node --test test/puuush.test.js",
    "check": "node --test test/puuush.test.js && node --check src/main.js && node --check src/upload.js && node --check server/index.js"
  },
  "build": {
    "appId": "com.blinov.puuush",
    "productName": "puuush",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "assets/icon.png",
      "maintainer": "aa-blinov",
      "synopsis": "Скриншот области и ссылка в буфере"
    }
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  }
}
